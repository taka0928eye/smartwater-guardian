# --- Orcarouter LLM API（BE-5） ---
# 実キーはコミットしない（NFR-4）。未設定なら安全にフォールバック動作（source == "fallback"）する。
ORCAROUTER_API_KEY=your_orcarouter_api_key_here
# 接続先エンドポイント（既定値はコード内のプレースホルダ。デモ直前に実 URL を注入）
ORCAROUTER_BASE_URL=https://orcarouter.example.com/v1
# 使用モデル識別子（Orcarouter はルーティングするため、レスポンスの実モデル名を優先する）
ORCAROUTER_MODEL=orcarouter
# "false" で LLM 呼び出しを強制無効化し、フォールバック動作にする
ORCAROUTER_ENABLED=true

PORT=8000
